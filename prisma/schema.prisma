generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OpportunityStatus {
  NEW
  NEEDS_REVIEW
  DRAFTED
  APPROVED
  ARCHIVED
  PUBLISHED
  DISCARDED
  FOLLOW_UP
  CONVERTED
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityIntent {
  PURCHASE_QUESTION
  TECHNICAL_QUESTION
  PRICE_QUESTION
  WARRANTY_QUESTION
  COMPARISON
  COMPLAINT
  COMPETITOR_MENTION
  GENERAL_DISCUSSION
}

enum ResponseVariantType {
  SHORT
  TECHNICAL
  CONVERSATIONAL
}

enum IssueReportStatus {
  OPEN
  RESOLVED
}

// ─── Multi-Cliente ─────────────────────────────────────────────────────────────

model Client {
  manualCMJobs           CMManualJob[]
  cmCoverage             CMCoverageSnapshot?
  id                     String                @id @default(cuid())
  name                   String                @unique
  slug                   String                @unique
  description            String                @default("")
  domainKeywords         String                @default("[]")
  domainExclusions       String                @default("[]")
  dailyOpportunityTarget Int                   @default(50)
  dailyDraftTarget       Int                   @default(50)
  responsePolicy         Json                  @default("{}")
  opportunitySearchState Json                  @default("{}")
  autoPublish            Boolean               @default(false)
  autoApprove            Boolean               @default(false)
  active                 Boolean               @default(true)
  openrouterApiKey       String                @default("")
  openrouterModel        String                @default("")
  // Branding / landings
  storeUrl               String                @default("")
  blogBaseUrl            String                @default("")
  labName                String                @default("")
  logoUrl                String                @default("")
  landingTemplate        String                @default("")
  landingPrimaryColor    String                @default("")
  landingSecondaryColor  String                @default("")
  // Email / nurturing (Fase 2)
  fromName               String                @default("")
  fromEmail              String                @default("")
  smtpHost               String                @default("")
  smtpPort               Int                   @default(465)
  smtpUser               String                @default("")
  smtpPass               String                @default("")
  unsubscribeBaseUrl     String                @default("")
  trackBaseUrl           String                @default("")
  // GEO (Fase 3)
  geoBrandPatterns       Json                  @default("[]")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  brands                 Brand[]
  personas               Persona[]
  monitoredSources       MonitoredSource[]
  catalogRules           CatalogRule[]
  landingCategories      LandingCategory[]
  landingProducts        LandingProduct[]
  seedTopics             SeedTopic[]
  catalogSyncRuns        CatalogSyncRun[]
  landings               Landing[]
  contentClusters        ContentCluster[]
  landingInternalLinks   LandingInternalLink[]
  trackingEvents         TrackingEvent[]
  youtubeConnections     YouTubeConnection[]
  users                  User[]
  loginAuditEvents       LoginAuditEvent[]
  opportunities          Opportunity[]
  observedProfiles       ObservedProfile[]
  blogPublications       BlogPublication[]
  competitorEvidence     CompetitorEvidence[]
  businessProfile        BusinessProfile?
  businessCompetitors    BusinessCompetitor[]
  businessAnalysisRuns   BusinessAnalysisRun[]
  draftJobs              DraftJob[]
  supportSessions        SupportSession[]
  adminAuditEvents       AdminAuditEvent[]
  memories               ClientMemory[]
  onboarding             ClientOnboarding?
  userInvitations        UserInvitation[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  authUserId      String?   @unique @db.Uuid
  name            String
  role            String    @default("operator") // "admin" | "operator"
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserInvitation {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("operator") // "admin" | "operator"
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

model RateLimitHit {
  id    String   @id @default(cuid())
  key   String
  hitAt DateTime @default(now())

  @@index([key, hitAt])
}

model LoginAuditEvent {
  id        String   @id @default(cuid())
  clientId  String?
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ipAddress String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([clientId, createdAt])
  @@map("login_audit_events")
}

model PlatformAdminProfile {
  id              String            @id @default(cuid())
  authUserId      String            @unique @db.Uuid
  name            String
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  supportSessions SupportSession[]
  auditEvents     AdminAuditEvent[]

  @@index([active])
}

model SupportSession {
  id              String               @id @default(cuid())
  platformAdminId String
  clientId        String
  reason          String
  tokenHash       String               @unique
  expiresAt       DateTime
  exchangedAt     DateTime?
  revokedAt       DateTime?
  endedAt         DateTime?
  ipAddress       String               @default("")
  userAgent       String               @default("")
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  platformAdmin   PlatformAdminProfile @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  auditEvents     AdminAuditEvent[]

  @@index([platformAdminId, createdAt])
  @@index([clientId, expiresAt])
  @@index([revokedAt])
}

model AdminAuditEvent {
  id               String               @id @default(cuid())
  actorId          String
  clientId         String?
  supportSessionId String?
  action           String
  targetType       String
  targetId         String?
  ipAddress        String               @default("")
  userAgent        String               @default("")
  metadata         Json                 @default("{}")
  createdAt        DateTime             @default(now())
  actor            PlatformAdminProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)
  client           Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?      @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([clientId, createdAt])
  @@index([supportSessionId])
}

model CatalogRule {
  id        String   @id @default(cuid())
  clientId  String
  category  String
  keywords  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, category])
}

model PersonaRule {
  id        String   @id @default(cuid())
  personaId String
  weight    Int      @default(3)
  trigger   String
  pattern   String
  reason    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

// ─── Modelos de Negocio ───────────────────────────────────────────────────────

model Brand {
  id                   String        @id @default(cuid())
  clientId             String?
  name                 String
  strengths            String        @map("positioning")
  tone                 String
  allowedClaims        String        @default("")
  forbiddenClaims      String        @default("")
  competitorWeaknesses String        @default("")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  client               Client?       @relation(fields: [clientId], references: [id])
  opportunities        Opportunity[]
  products             Product[]
  services             Service[]
  responses            Response[]

  @@unique([clientId, name])
}

model Product {
  id               String        @id @default(cuid())
  brandId          String
  name             String
  category         String
  description      String
  technicalSpecs   String        @default("")
  useCases         String        @default("")
  warrantyNotes    String        @default("")
  stockStatus      String        @default("Por confirmar")
  priceRange       String        @default("Por confirmar")
  sourceType       String        @default("manual")
  sourceExternalId String?
  sourceUrl        String        @default("")
  sourceSnapshotAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  opportunities    Opportunity[]
  brand            Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
}

model Persona {
  id               String        @id @default(cuid())
  clientId         String?
  name             String
  role             String
  tone             String
  goals            String
  preferredLength  String
  allowedPhrases   String        @default("")
  forbiddenPhrases String        @default("")
  goodExamples     String        @default("")
  badExamples      String        @default("")
  angle            String        @default("")
  avatarUrl        String        @default("")
  voiceId          String        @default("es-AR-TomasNeural")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  client           Client?       @relation(fields: [clientId], references: [id])
  responses        Response[]
  rules            PersonaRule[]

  @@unique([clientId, name])
}

model Channel {
  id                 String        @id @default(cuid())
  name               String        @unique
  type               String
  baseUrl            String
  responseStyleNotes String
  opportunities      Opportunity[]
}

model Opportunity {
  manualCMJobs           CMManualJob[]
  id                     String              @id @default(cuid())
  channelId              String
  sourceUrl              String
  sourceAuthor           String              @default("")
  sourceText             String
  /// Título de la fuente (video de YouTube, hilo, resultado). En videos, sourceText
  /// empieza con este título seguido de la descripción.
  sourceTitle            String              @default("")
  signalType             String              @default("actionable_question")
  clientId               String?
  observedProfileId      String?
  detectedBrandId        String?
  detectedProductId      String?
  detectedIntent         OpportunityIntent   @default(GENERAL_DISCUSSION)
  priority               OpportunityPriority @default(MEDIUM)
  opportunityScore       Int                 @default(0)
  contextAssessment      Json                @default("{}")
  status                 OpportunityStatus   @default(NEW)
  detectedTopics         Json                @default("[]")
  detectedTone           String              @default("")
  detectedToneConfidence String              @default("low")
  /// Idioma del comentario: es | en | pt | de | other ("" = sin detectar). Filtro del Asistente CM.
  language               String              @default("")
  notes                  String              @default("")
  monitoredSourceId      String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  channel                Channel             @relation(fields: [channelId], references: [id])
  client                 Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  observedProfile        ObservedProfile?    @relation(fields: [observedProfileId], references: [id])
  detectedBrand          Brand?              @relation(fields: [detectedBrandId], references: [id])
  detectedProduct        Product?            @relation(fields: [detectedProductId], references: [id])
  monitoredSource        MonitoredSource?    @relation(fields: [monitoredSourceId], references: [id])
  publishingLogs         PublishingLog[]
  responses              Response[]
  draftJob               DraftJob?
  landings               Landing[]
  observedEvent          ObservedEvent?
  memories               ClientMemory[]

  @@index([status])
  @@index([priority])
  @@index([opportunityScore(sort: Desc), createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([channelId])
  @@index([clientId])
  @@index([observedProfileId])
  @@index([detectedBrandId])
  @@index([detectedProductId])
  @@index([monitoredSourceId])
  @@index([clientId, language])
}

model ObservedProfile {
  id                  String             @id @default(cuid())
  clientId            String
  platform            String
  externalHandle      String
  displayName         String             @default("")
  profileUrl          String             @default("")
  toneSummary         String             @default("")
  toneConfidence      String             @default("low")
  profileStatus       String             @default("active")
  primaryTopics       Json               @default("[]")
  secondaryTopics     Json               @default("[]")
  engagementPattern   Json               @default("{}")
  commercialReadiness Float              @default(0)
  firstSeenAt         DateTime           @default(now())
  lastSeenAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interests           ObservedInterest[]
  events              ObservedEvent[]
  opportunities       Opportunity[]

  @@unique([clientId, platform, externalHandle])
  @@index([clientId])
  @@index([platform])
  @@index([lastSeenAt])
}

model ObservedInterest {
  id                String          @id @default(cuid())
  observedProfileId String
  topicKey          String
  weight            Float           @default(0)
  confidence        String          @default("low")
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  evidenceCount     Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  observedProfile   ObservedProfile @relation(fields: [observedProfileId], references: [id], onDelete: Cascade)

  @@unique([observedProfileId, topicKey])
  @@index([observedProfileId])
  @@index([topicKey])
}

model ObservedEvent {
  id                 String              @id @default(cuid())
  observedProfileId  String
  opportunityId      String              @unique
  sourceTextSnapshot String
  primaryTopicKey    String              @default("general")
  secondaryTopicKeys Json                @default("[]")
  topicConfidence    String              @default("low")
  toneSummary        String              @default("")
  toneConfidence     String              @default("low")
  detectedIntent     OpportunityIntent   @default(GENERAL_DISCUSSION)
  detectedPriority   OpportunityPriority @default(MEDIUM)
  signalSummary      String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  observedProfile    ObservedProfile     @relation(fields: [observedProfileId], references: [id], onDelete: Cascade)
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([observedProfileId])
  @@index([primaryTopicKey])
  @@index([createdAt])
}

model Response {
  id                  String              @id @default(cuid())
  opportunityId       String
  personaId           String
  brandId             String
  variantType         ResponseVariantType
  voiceVariant        String              @default("")
  voiceVariantReason  String              @default("")
  draftText           String
  editedText          String              @default("")
  riskNotes           String              @default("")
  isPrimary           Boolean             @default(false)
  evidence            Json                @default("[]")
  chatHistory         Json                @default("[]")
  approvedBy          String              @default("")
  acceptedAsCorrectAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  publishingLog       PublishingLog?
  brand               Brand               @relation(fields: [brandId], references: [id])
  opportunity         Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  persona             Persona             @relation(fields: [personaId], references: [id])
  memories            ClientMemory[]

  @@index([opportunityId])
  @@index([personaId])
  @@index([brandId])
  @@index([acceptedAsCorrectAt])
}

model ClientMemory {
  id            String       @id @default(cuid())
  clientId      String
  rule          String
  summary       String       @default("")
  category      String       @default("general") // tone | warranty | product | store | mistake | general
  source        String       @default("chat_refinement") // chat_refinement | manual
  opportunityId String?
  responseId    String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  response      Response?    @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([opportunityId])
  @@index([responseId])
  @@index([responseId, source])
}

model Service {
  id                String    @id @default(cuid())
  brandId           String
  name              String
  category          String    @default("")
  description       String    @default("")
  scope             String    @default("")
  modality          String    @default("")
  audience          String    @default("")
  priceRange        String    @default("Por confirmar")
  availabilityNotes String    @default("Por confirmar")
  sourceType        String    @default("manual")
  sourceExternalId  String?
  sourceUrl         String    @default("")
  sourceSnapshotAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  brand             Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@index([brandId])
  @@index([sourceExternalId])
}

enum OnboardingStatus {
  NOT_STARTED
  ANALYZING
  IN_REVIEW
  COMPLETED
}

/// Estado durable del alta autoservicio. `draft` conserva propuestas de IA
/// hasta que el administrador las revisa y confirma.
model ClientOnboarding {
  id            String                 @id @default(cuid())
  clientId      String                 @unique
  status        OnboardingStatus       @default(NOT_STARTED)
  currentStep   Int                    @default(1)
  sourceUrl     String                 @default("")
  businessType  String                 @default("")
  draft         Json                   @default("{}")
  analysisError String                 @default("")
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourcePages   OnboardingSourcePage[]

  @@index([status])
}

/// Evidencia liviana del análisis web. Guarda sólo texto extraído y metadatos,
/// nunca HTML completo ni datos de usuarios del sitio fuente.
model OnboardingSourcePage {
  id           String           @id @default(cuid())
  onboardingId String
  url          String
  title        String           @default("")
  pageType     String           @default("other")
  contentHash  String           @default("")
  excerpt      String           @default("")
  extracted    Json             @default("{}")
  fetchedAt    DateTime         @default(now())
  onboarding   ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, url])
  @@index([onboardingId])
}

model PublishingLog {
  id             String      @id @default(cuid())
  opportunityId  String
  responseId     String      @unique
  publishedUrl   String      @default("")
  publishedAt    DateTime    @default(now())
  publishedBy    String      @default("Operador")
  result         String      @default("no_reply")
  followUpNeeded Boolean     @default(false)
  createdAt      DateTime    @default(now())
  account        String      @default("")
  publishMethod  String      @default("manual")
  remoteId       String      @default("")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  response       Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

// Credencial OAuth de una cuenta YouTube autorizada por un cliente. Los tokens
// se guardan cifrados por la aplicación y nunca se exponen al navegador.
model YouTubeConnection {
  id           String    @id @default(cuid())
  clientId     String
  account      String
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
  channelId    String    @default("")
  channelTitle String    @default("")
  scopes       String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, account])
  @@index([clientId])
}

model KnowledgeBase {
  id         String   @id @default(cuid())
  clientId   String?
  brandId    String?
  productId  String?
  topic      String
  content    String
  source     String   @default("manual")
  confidence String   @default("medium")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Objection {
  id                String   @id @default(cuid())
  clientId          String?
  brandId           String?
  productId         String?
  objection         String
  recommendedAnswer String
  personaNotes      String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonitoredSource {
  id                String        @id @default(cuid())
  clientId          String?
  label             String        @unique
  channel           String
  query             String
  account           String        @default("")
  limit             Int           @default(5)
  targetUrl         String        @default("")
  sourceKind        String        @default("query")
  lifecycle         String        @default("active")
  priority          Int           @default(50)
  expectedTopics    Json          @default("[]")
  emptyReads        Int           @default(0)
  lastEvidenceAt    DateTime?
  blockedReason     String        @default("")
  active            Boolean       @default(true)
  lastRunAt         DateTime?
  lastCount         Int           @default(0)
  lastItemsRead     Int           @default(0)
  lastCandidates    Int           @default(0)
  lastDiscarded     Int           @default(0)
  lastError         String        @default("")
  lastDiscoveryMode String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  client            Client?       @relation(fields: [clientId], references: [id])
  opportunities     Opportunity[]
}

model PromptVersion {
  id                 String   @id @default(cuid())
  name               String
  version            String
  systemPrompt       String
  userPromptTemplate String
  active             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([name, version])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  event     String
  message   String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([level])
  @@index([event])
  @@index([createdAt])
}

// ─── Módulo de Landings SEO (ex-AgentesGuille) ───────────────────────────────

enum LandingStatus {
  DRAFT
  APPROVED
  PREVIEW_ONLINE
  PUBLISHED
  ARCHIVED
}

enum LandingContentType {
  LEGACY
  PILLAR
  GUIDE
  CAMPAIGN
}

enum LandingIndexingState {
  INDEX
  NOINDEX
}

enum LandingInternalLinkMode {
  AUTO
  PINNED
  EXCLUDED
}

enum BlogPublicationStatus {
  PLANNED
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

model CompetitorEvidence {
  id               String    @id @default(cuid())
  clientId         String
  competitorBrand  String
  aliases          Json      @default("[]")
  model            String    @default("")
  topic            String
  observation      String
  testedBy         String    @default("")
  testedAt         DateTime?
  evidenceUrl      String    @default("")
  confidence       String    @default("medium")
  allowFirstPerson Boolean   @default(false)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, competitorBrand])
  @@index([clientId, active])
}

model DraftJob {
  id            String         @id @default(cuid())
  opportunityId String         @unique
  clientId      String
  status        DraftJobStatus @default(QUEUED)
  attempts      Int            @default(0)
  lockedBy      String         @default("")
  leaseUntil    DateTime?
  lastError     String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status, createdAt])
  @@index([status, leaseUntil])
}

model IssueReport {
  id          String            @id @default(cuid())
  sector      String
  originPath  String
  description String
  imageUrl    String            @default("")
  reportedBy  String            @default("default")
  status      IssueReportStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum DraftJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Landing {
  language        String?
  translationOfId String?

  id                    String                @id @default(cuid())
  clientId              String
  slug                  String
  keyword               String
  intent                String                @default("")
  titulo                String                @default("")
  htmlContent           String
  seoTitle              String                @default("")
  seoDescription        String                @default("")
  status                LandingStatus         @default(DRAFT)
  contentType           LandingContentType    @default(GUIDE)
  indexingState         LandingIndexingState  @default(INDEX)
  contentClusterId      String?
  authorName            String                @default("Equipo PC MIDI Center")
  sourceRefs            Json                  @default("[]")
  publicPreviewUrl      String                @default("")
  previewPublishedAt    DateTime?
  publishedAt           DateTime?
  opportunityId         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentCluster        ContentCluster?       @relation("LandingContentCluster", fields: [contentClusterId], references: [id], onDelete: SetNull)
  pillarFor             ContentCluster?       @relation("ContentClusterPillar")
  opportunity           Opportunity?          @relation(fields: [opportunityId], references: [id])
  trackingEvents        TrackingEvent[]
  outboundInternalLinks LandingInternalLink[] @relation("LandingInternalLinkSource")
  inboundInternalLinks  LandingInternalLink[] @relation("LandingInternalLinkTarget")
  blogPublication       BlogPublication?

  @@unique([clientId, slug])
  @@index([clientId, language])
  @@index([clientId, translationOfId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([clientId, indexingState, status])
  @@index([contentClusterId])
}

model BlogPublication {
  id               String                @id @default(cuid())
  clientId         String
  landingId        String?               @unique
  analysisRunId    String?
  requiresApproval Boolean               @default(false)
  approvedAt       DateTime?
  targetKeyword    String                @default("")
  plannedTitle     String                @default("")
  analysisRun      BusinessAnalysisRun?  @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  scheduledDate    DateTime              @db.Date
  dailySlot        Int                   @default(0)
  status           BlogPublicationStatus @default(PLANNED)
  attempts         Int                   @default(0)
  needsDeploy      Boolean               @default(false)
  revisionAttempts Int                   @default(0)
  lastError        String                @default("")
  errorCode        String                @default("")
  preparation      Json?
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  landing          Landing?              @relation(fields: [landingId], references: [id], onDelete: SetNull)

  @@unique([clientId, scheduledDate, dailySlot], name: "clientId_scheduledDate")
  @@index([clientId, status, scheduledDate])
  @@index([analysisRunId])
}

/// Perfil aplicado automáticamente; las correcciones manuales tienen prioridad.
model BusinessProfile {
  id               String    @id @default(cuid())
  clientId         String    @unique
  sourceUrl        String    @default("")
  data             Json      @default("{}")
  monthlyEnabled   Boolean   @default(true)
  nextAnalysisAt   DateTime?
  lastSuccessfulAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([monthlyEnabled, nextAnalysisAt])
}

model BusinessCompetitor {
  id        String   @id @default(cuid())
  clientId  String
  domain    String
  reason    String   @default("")
  sourceUrl String   @default("")
  excluded  Boolean  @default(false)
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, domain])
}

model BusinessAnalysisRun {
  id             String            @id @default(cuid())
  clientId       String
  sourceUrl      String            @default("")
  status         String            @default("QUEUED")
  stage          String            @default("website")
  attempts       Int               @default(0)
  checkpoint     Json              @default("{}")
  result         Json              @default("{}")
  errors         Json              @default("[]")
  leaseToken     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  publications   BlogPublication[]

  @@index([status, leaseExpiresAt])
  @@index([clientId, startedAt])
}

model ContentCluster {
  id              String    @id @default(cuid())
  clientId        String
  slug            String
  name            String
  description     String    @default("")
  pillarLandingId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pillarLanding   Landing?  @relation("ContentClusterPillar", fields: [pillarLandingId], references: [id], onDelete: SetNull)
  landings        Landing[] @relation("LandingContentCluster")

  @@unique([clientId, slug])
  @@index([clientId])
}

model LandingInternalLink {
  id              String                  @id @default(cuid())
  clientId        String
  sourceLandingId String
  targetLandingId String
  anchorText      String                  @default("")
  position        Int                     @default(0)
  mode            LandingInternalLinkMode @default(AUTO)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  client          Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceLanding   Landing                 @relation("LandingInternalLinkSource", fields: [sourceLandingId], references: [id], onDelete: Cascade)
  targetLanding   Landing                 @relation("LandingInternalLinkTarget", fields: [targetLandingId], references: [id], onDelete: Cascade)

  @@unique([sourceLandingId, targetLandingId])
  @@index([clientId, sourceLandingId])
  @@index([clientId, targetLandingId])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  clientId  String?
  eventType String
  slug      String
  referrer  String   @default("")
  meta      Json     @default("{}")
  landingId String?
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id])
  landing   Landing? @relation(fields: [landingId], references: [id])

  @@index([clientId])
  @@index([slug])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Catálogo de Landings (Pipeline B, multi-cliente) ────────────────────────

model LandingCategory {
  id              String    @id @default(cuid())
  clientId        String
  key             String
  name            String
  url             String    @default("")
  description     String    @default("")
  keywords        Json      @default("[]")
  tiendanubeId    String?
  sourceSnapshot  Json      @default("{}")
  lastSeenAt      DateTime?
  missingRuns     Int       @default(0)
  lastMissingDate String    @default("")
  linkStatus      String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@unique([clientId, tiendanubeId])
  @@index([clientId])
}

model LandingProduct {
  id              String    @id @default(cuid())
  clientId        String
  externalId      String
  name            String
  brand           String    @default("")
  model           String    @default("")
  categoryKey     String    @default("")
  url             String    @default("")
  useText         String    @default("")
  tiendanubeId    String?
  sourceSnapshot  Json      @default("{}")
  lastSeenAt      DateTime?
  missingRuns     Int       @default(0)
  lastMissingDate String    @default("")
  linkStatus      String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, externalId])
  @@unique([clientId, tiendanubeId])
  @@index([clientId])
  @@index([categoryKey])
}

model CatalogSyncRun {
  id                 String    @id @default(cuid())
  clientId           String
  status             String    @default("QUEUED")
  checkpoint         Json      @default("{}")
  changes            Json      @default("[]")
  errors             Json      @default("[]")
  deployment         Json      @default("{}")
  deploymentAttempts Int       @default(0)
  startedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  finishedAt         DateTime?
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@index([clientId, status])
}

model SeedTopic {
  id                  String   @id @default(cuid())
  clientId            String
  keyword             String
  intent              String   @default("")
  suggestedCategories Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([keyword])
}

// UI summaries are never used to authorize generation or publication.
model CMCoverageSnapshot {
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CMCoverageSnapshot_client_fk")
  clientId      String   @id
  version       String   @default("")
  rows          Json     @default("[]")
  counts        Json     @default("{}")
  calculatedAt  DateTime @default(now())
  invalidatedAt DateTime @default(now())
  requestedAt   DateTime @default(now())
}

model CMManualJob {
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CMManualJob_client_fk")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CMManualJob_opportunity_fk")
  id             String      @id @default(cuid())
  clientId       String
  requestedBy    String
  opportunityId  String
  action         String
  parameters     Json
  idempotencyKey String
  inputVersion   String
  status         String      @default("QUEUED")
  attempts       Int         @default(0)
  lockedBy       String      @default("")
  leaseUntil     DateTime?
  availableAt    DateTime    @default(now())
  result         Json?
  error          String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([status, availableAt])
  @@index([clientId, createdAt])
}
