# ─── Base de datos ────────────────────────────────────────────────────────────
# Supabase (producción) — obtener desde dashboard → Connect → ORMs
# Transaction pooler (queries normales de la app y agentes Python)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migraciones, prisma db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
# Supabase API (src/lib/supabase.ts — subidas a Storage, REST)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

APP_ENV="development"
# SQLite heredado queda bloqueado por defecto. Sólo habilitar para recuperar
# datos locales antiguos fuera de producción.
ALLOW_SQLITE_SANDBOX=""
# URL pública de la app (links absolutos en emails/previews)
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── IA ───────────────────────────────────────────────────────────────────────
# Estas son el FALLBACK global. Cada cliente puede cargar su propia API key y
# modelo desde el dashboard (/clients), que tienen prioridad sobre estas.
# Proveedor global: "local" para Ollama/OpenAI-compatible o "openrouter".
LLM_PROVIDER="local"
LLM_BASE_URL="http://192.168.1.200:11434/v1"
LLM_MODEL="qwen2.5:32b"
LLM_API_KEY="ollama"

# Compatibilidad legacy; las credenciales por cliente aplican con openrouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324:free"
# Audit GEO multi-modelo (opcional, separar por comas)
GEO_AUDIT_MODELS=""

# D-ID (Generación de videos con Avatares)
# Dejar vacío o "mock" para usar el simulador local de renderizado gratuito sin API
DID_API_KEY=""
DID_DEFAULT_AVATAR_URL=""

# Proveedores de video alternativos (opcionales)
HEYGEN_API_KEY=""
CREATOMATE_API_KEY=""
CREATOMATE_TEMPLATE_ID=""
# Binario ffmpeg (default: el de ffmpeg-static)
FFMPEG_BIN=""

# Render local comercial de videos con avatar
# local = Edge-TTS + Wav2Lip/FFmpeg local. did = fallback externo con D-ID.
VIDEO_RENDER_PROVIDER="local"
LOCAL_AVATAR_MODE="wav2lip"
LOCAL_AVATAR_FALLBACK_MODE="loop"
PYTHON_BIN="python"
AGENTS_PYTHON_BIN=""
LOCAL_AVATAR_TEMPLATE_DIR="assets/avatar-templates"
LOCAL_VIDEO_OUTPUT_DIR="public/videos"
WAV2LIP_INFERENCE_SCRIPT="models/wav2lip/inference.py"
WAV2LIP_MODEL_PATH="models/wav2lip/wav2lip_gan.pth"

# ─── Autenticación del dashboard ─────────────────────────────────────────────
AUTH_PASSWORD=""
AUTH_SECRET=""
# Usuarios por entorno (JSON): [{"username":"fede","password":"...","label":"Fede","role":"admin","clientSlugs":["pcmidi"]}]
AUTH_USERS_JSON=""

# ─── NSTBrowser (automatización de navegador, provider por defecto) ───────────
NSTBROWSER_API_KEY=""
NSTBROWSER_API_BASE="http://localhost:8848/api/v2"
NSTBROWSER_HEADLESS="false"

# ─── Dolphin Anty (provider alternativo de perfiles) ─────────────────────────
DOLPHIN_API_TOKEN=""
DOLPHIN_API_BASE="http://localhost:3001/v1.0"

# Ruta a un Chrome local si no se usa Dolphin/NSTBrowser (opcional)
CHROME_PATH=""
# Override de la ruta de agents/accounts.json (opcional)
ACCOUNTS_JSON=""

# ─── Cuentas sociales — quinteto de personas ─────────────────────────────────
# Nunca commitear valores reales. Solo cuentas propias/autorizadas.
APOSTOLES_PROFE_USER=""
APOSTOLES_PROFE_PASSWORD=""
APOSTOLES_PRODUCTOR_USER=""
APOSTOLES_PRODUCTOR_PASSWORD=""
APOSTOLES_BATERISTA_USER=""
APOSTOLES_BATERISTA_PASSWORD=""
APOSTOLES_KRESSMER_USER=""
APOSTOLES_KRESSMER_PASSWORD=""
APOSTOLES_CAZADOR_USER=""
APOSTOLES_CAZADOR_PASSWORD=""

# ─── Cuentas Prestige Running (medias deportivas) ────────────────────────────
PRESTIGE_CORREDOR_USER=""
PRESTIGE_CORREDOR_PASSWORD=""
PRESTIGE_TECNICO_USER=""
PRESTIGE_TECNICO_PASSWORD=""

# ─── Cuentas Prestige (nombres actuales en agents/accounts.json) ─────────────
APOSTOLES_DEPORTISTA_USER=""
APOSTOLES_DEPORTISTA_PASSWORD=""
APOSTOLES_DEPORTISTA_ENTRENADOR_USER=""
APOSTOLES_DEPORTISTA_ENTRENADOR_PASSWORD=""

# ─── Agent relay (acceso remoto) ──────────────────────────────────────────────
# Vercel: AGENT_RELAY_URL y AGENT_RELAY_TOKEN son obligatorias para delegar
# agentes Python al relay local expuesto por el tunnel de Cloudflare.
AGENT_RELAY_PORT=4242
AGENT_RELAY_TOKEN=""
AGENT_RELAY_URL=""

# ─── Nurturing por email (SMTP) ───────────────────────────────────────────────
NURTURE_SMTP_HOST=""
NURTURE_SMTP_PORT=465
NURTURE_SMTP_USER=""
NURTURE_SMTP_PASS=""
NURTURE_FROM_EMAIL="lab@pcmidicenter.com"
NURTURE_FROM_NAME="Bruno de PC MIDI Labs"
NURTURE_UNSUBSCRIBE_BASE_URL="https://blog.pcmidicenter.com/api/unsubscribe/"
NURTURE_TRACK_BASE_URL="https://blog.pcmidicenter.com"
NURTURE_UNSUBSCRIBE_SECRET=""
NURTURE_CRON_SECRET=""

# ─── Deploy landings estáticas ────────────────────────────────────────────────
LANDING_BASE_URL="https://blog.pcmidicenter.com"
DEPLOY_TARGET="vercel"
VERCEL_TOKEN=""
VERCEL_SCOPE=""

# ─── APIs de investigación (opcionales) ───────────────────────────────────────
SERPER_API_KEY=""

# ─── Tuning de agentes (opcionales, tienen default razonable) ────────────────
# Timeout del clasificador IA de oportunidades (default 12000)
OPPORTUNITY_CLASSIFIER_TIMEOUT_MS=120000
DAILY_DRAFT_TIMEOUT_MS=0
PRESTIGE_DRAFT_UNIQUENESS_ATTEMPTS=8
# Cuota diaria de oportunidades por cliente
DAILY_QUOTA_CONCURRENCY=2
DAILY_QUOTA_LISTEN_TIMEOUT_MS=240000
DAILY_QUOTA_IMPORT_TIMEOUT_MS=240000
DAILY_QUOTA_MAX_ROUNDS=3
# Radar de tendencias
TRENDS_KEYWORDS_PER_SOURCE=3
TRENDS_TIME_BUDGET_SECONDS=600
# Logs de agentes Python (AGENT_LOG_DEBUG=1 para verbose)
AGENT_LOG_FILE=""
AGENT_LOG_DEBUG=""
# Reintentos HTTP de agentes Python
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# ─── APIs sociales oficiales (legacy agente_publicacion, opcional) ───────────
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_USER_AGENT="pcmidi_distribucion/1.0"
TWITTER_BEARER_TOKEN=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""

# ─── Escucha social gratuita autoalojada ─────────────────────────────────────
# Iniciar con: docker compose -f docker-compose.social-listening.yml up -d
SEARXNG_URL="http://127.0.0.1:8080"
RSSHUB_URL="http://127.0.0.1:1200"
# Rutas RSSHub opcionales. {query} se reemplaza y codifica automáticamente.
# RSSHUB_FEED_YOUTUBE="/youtube/search/{query}"
