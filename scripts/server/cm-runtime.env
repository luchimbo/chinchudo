# Ajustes del Asistente CM en el servidor "pcmidi". Solo los cargan el procesador
# de la cola y el mantenimiento (scripts/start-cm-runtime-ssh.sh), encima del .env
# del servidor, que tiene las claves. El blog no los lee. Sin secretos: va en git.
CM_MANUAL_QUEUE=true
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_PROVIDER=schedule
LLM_SCHEDULE_TIMEZONE=America/Argentina/Buenos_Aires
LLM_LOCAL_START=09:30
LLM_LOCAL_END=17:30
# Ollama corre en el mismo servidor.
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_MODEL=qwen3.8:latest
