# Búsqueda de oportunidades en el servidor "pcmidi": Chrome sin pantalla, un perfil y un puerto
# CDP por cuenta (agents/accounts.json del servidor, browserProvider "chrome"). Lo cargan el
# servicio del servidor (búsqueda manual) y scripts/server/listening-ssh.sh (la programada).
CHROME_PATH=/home/administrador/services/chrome/chrome-linux64/chrome
# shlex: lo que va entre comillas simples es un solo argumento.
CHROME_EXTRA_ARGS="--headless=new --window-size=1366,900 --lang=es-AR --disable-gpu --mute-audio --user-agent='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36'"
