generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id              String            @id
  name            String            @unique
  slug            String            @unique
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  users           User[]
  opportunities   Opportunity[]
  leads           Lead[]
  supportSessions SupportSession[]
  adminAuditEvents AdminAuditEvent[]
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("operator")
  clientId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id       String  @id
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id       String  @id
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
}

model PlatformAdminProfile {
  id              String            @id
  authUserId      String            @unique @db.Uuid
  name            String
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  supportSessions SupportSession[]
  auditEvents     AdminAuditEvent[]
}

model SupportSession {
  id              String               @id @default(cuid())
  platformAdminId String
  clientId        String
  reason          String
  tokenHash       String               @unique
  expiresAt       DateTime
  exchangedAt     DateTime?
  revokedAt       DateTime?
  endedAt         DateTime?
  ipAddress       String               @default("")
  userAgent       String               @default("")
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  platformAdmin   PlatformAdminProfile @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  auditEvents     AdminAuditEvent[]
}

model AdminAuditEvent {
  id               String               @id @default(cuid())
  actorId          String
  clientId         String?
  supportSessionId String?
  action           String
  targetType       String
  targetId         String?
  ipAddress        String               @default("")
  userAgent        String               @default("")
  metadata         Json                 @default("{}")
  createdAt        DateTime             @default(now())
  actor            PlatformAdminProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)
  client           Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?      @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)
}
