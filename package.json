{
  "name": "pcmidi-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:server": "node scripts/dev-server.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:start": "npm --prefix apps/admin run start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "node scripts/db-apply-diff.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "demo:seed-local": "tsx scripts/seed-local-demo.mts",
    "admin:register": "tsx scripts/register-platform-admin.mts",
    "db:seed-jurispedia": "tsx scripts/seed-jurispedia.mts",
    "db:seed-programa-vidia": "tsx scripts/seed-programa-vidia.mts",
    "db:seed-catalog-jurispedia": "tsx scripts/import-catalog-jurispedia.mts",
    "db:seed-catalog-vidia": "tsx scripts/import-catalog-vidia.mts",
    "brand:snapshots": "tsx scripts/capture-brand-snapshots.mts",
    "brand:snapshots:install": "powershell -ExecutionPolicy Bypass -File scripts/registrar-brand-snapshots-admin.ps1",
    "agents:jurispedia:publish": "tsx scripts/configure-jurispedia-autopublish.mts",
    "agents:jurispedia:calibrate": "tsx scripts/seed-jurispedia-calibration.mts && tsx scripts/draft-worker.mts --client jurispedia --limit 4",
    "db:studio": "prisma studio",
    "agents:listen": "python agents/orchestrator.py listen",
    "onboarding:sync-catalog": "tsx scripts/sync-pending-onboarding-catalog.mts",
    "agents:draft": "python agents/orchestrator.py draft",
    "agents:draft-daily-quota": "node node_modules/tsx/dist/cli.mjs scripts/daily-draft-quota.mts",
    "agents:regenerate-drafts": "node node_modules/tsx/dist/cli.mjs scripts/draft-worker.mts --replace-pending --limit 50",
    "agents:triage": "npx tsx scripts/triage-opportunities.mts",
    "agents:reclassify-contextual": "npx tsx scripts/reclassify-contextual-opportunities.mts",
    "agents:backfill": "npx tsx scripts/backfill-personas.mts",
    "db:seed-sources": "npx tsx scripts/seed-monitored-sources.mts",
    "agents:export": "python agents/orchestrator.py export",
    "agents:daily": "python agents/orchestrator.py daily",
    "agents:daily-quota": "node node_modules/tsx/dist/cli.mjs scripts/daily-opportunity-quota.mts",
    "agents:verify-coverage": "node node_modules/tsx/dist/cli.mjs scripts/verify-social-coverage.mts",
    "agents:discover-sources": "node node_modules/tsx/dist/cli.mjs scripts/discover-radar-sources.mts",
    "agents:validate-sources": "node node_modules/tsx/dist/cli.mjs scripts/validate-radar-sources.mts",
    "agents:listening-health": "python agents/social-listen.py --health",
    "agents:seed-prestige-radar": "npx tsx scripts/seed-prestige-radar.mts",
    "agents:monitor": "python agents/orchestrator.py monitor",
    "agents:healthcheck": "python agents/orchestrator.py healthcheck",
    "agents:publish": "tsx scripts/publish-response.mjs",
    "agents:research": "python agents/orchestrator.py research",
    "agents:generate": "python agents/orchestrator.py generate",
    "agents:build-landings": "python agents/orchestrator.py build-landings",
    "agents:nurture": "python agents/orchestrator.py nurture",
    "agents:distribution": "python agents/orchestrator.py distribution generate",
    "agents:geo-audit": "python agents/orchestrator.py geo-audit",
    "agents:conversion": "python agents/orchestrator.py conversion",
    "agents:trend-listen": "python agents/orchestrator.py trend-listen",
    "agents:trends:install": "powershell -ExecutionPolicy Bypass -File scripts/registrar-tendencias-admin.ps1",
    "db:backup": "node scripts/backup-db.mjs",
    "db:supabase-push": "prisma db push",
    "relay": "node scripts/agent-relay.mjs",
    "relay:start": "node scripts/start-relay.mjs",
    "llm:tunnel:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-llm-tunnel.ps1",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.2.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
